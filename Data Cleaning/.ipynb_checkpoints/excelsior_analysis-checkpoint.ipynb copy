   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "rows = []\ncontexts = {\"All public\": panel, \"Higher-Pell institutions\": panel[panel[\"high_pell_inst\"] == 1],\n            \"Lower-Pell institutions\": panel[panel[\"high_pell_inst\"] == 0]}\nfor cname, d in contexts.items():\n    for k in SL:\n        r = did(k, data=d)\n        lin = pretrend_test(k, data=d)\n        _, tests = event_study(k, data=d)\n        base = d.loc[(d[\"fall_year\"] == 2016) & (d[\"ny\"] == 1), k].mean()\n        rows.append({\"context\": cname, \"social_location\": label(k),\n                     \"ny_mean_2016\": base, \"did\": r[\"coef\"], \"se\": r[\"se\"], \"p\": r[\"p\"],\n                     \"pct_of_2016_mean\": 100 * r[\"coef\"] / base if base else np.nan,\n                     \"linear_pre_p\": lin[\"p\"], \"joint_pre_p\": tests[\"pre_p\"],\n                     \"interpretable\": \"yes\" if (lin[\"p\"] >= .05 and tests[\"pre_p\"] >= .05) else \"no\"})\nsl_table = pd.DataFrame(rows)\nsl_table.round(3)"
